{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "events_1337.json — eventos históricos 1337-1399 (GDD §7.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "year",
          "trigger",
          "effects",
          "news",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "year": {
            "type": "integer",
            "minimum": 1337,
            "maximum": 1399
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "year_reached",
                  "war"
                ]
              },
              "factions": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "england",
                    "france",
                    "hre",
                    "bohemia",
                    "hungary",
                    "castile",
                    "aragon",
                    "poland",
                    "scotland",
                    "papacy",
                    "granada",
                    "mamluks",
                    "golden_horde",
                    "byzantium"
                  ]
                }
              }
            }
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "population_modifier",
                    "gold_modifier",
                    "stability_modifier",
                    "prestige_modifier",
                    "relation_modifier",
                    "casus_belli",
                    "peace",
                    "tech_unlock",
                    "army_loss",
                    "recruit_pool_modifier"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "value": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "faction": {
                  "type": "string",
                  "enum": [
                    "england",
                    "france",
                    "hre",
                    "bohemia",
                    "hungary",
                    "castile",
                    "aragon",
                    "poland",
                    "scotland",
                    "papacy",
                    "granada",
                    "mamluks",
                    "golden_horde",
                    "byzantium"
                  ]
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "england",
                    "france",
                    "hre",
                    "bohemia",
                    "hungary",
                    "castile",
                    "aragon",
                    "poland",
                    "scotland",
                    "papacy",
                    "granada",
                    "mamluks",
                    "golden_horde",
                    "byzantium"
                  ]
                },
                "region": {
                  "type": "string",
                  "pattern": "^region_[a-z][a-z0-9_]*$"
                },
                "duration": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "news": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          }
        }
      }
    }
  }
}
