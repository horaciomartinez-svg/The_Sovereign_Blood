{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "scenarios/scenario_YYYY.json — The Sovereign's Blood (Fase 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "start_year",
    "end_year",
    "factions",
    "initial_state",
    "victory",
    "events_script"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "scenario_1337",
        "scenario_1402",
        "scenario_1453"
      ]
    },
    "title": {
      "type": "string",
      "enum": [
        "Dos Coronas",
        "El Choque de Imperios",
        "El Ocaso y el Alba"
      ]
    },
    "description": {
      "type": "string"
    },
    "start_year": {
      "type": "integer",
      "enum": [
        1337,
        1402,
        1453
      ]
    },
    "end_year": {
      "type": "integer",
      "enum": [
        1399,
        1460,
        1480
      ]
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "england",
          "france",
          "hre",
          "bohemia",
          "hungary",
          "castile",
          "aragon",
          "poland",
          "scotland",
          "papacy",
          "granada",
          "mamluks",
          "golden_horde",
          "byzantium",
          "brittany",
          "burgundy",
          "florence",
          "genoa",
          "milan",
          "naples",
          "ottoman",
          "tamerlane",
          "venice"
        ]
      }
    },
    "playable_factions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "england",
          "france",
          "hre",
          "bohemia",
          "hungary",
          "castile",
          "aragon",
          "poland",
          "scotland",
          "papacy",
          "granada",
          "mamluks",
          "golden_horde",
          "byzantium",
          "brittany",
          "burgundy",
          "florence",
          "genoa",
          "milan",
          "naples",
          "ottoman",
          "tamerlane",
          "venice"
        ]
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "regions",
        "treasuries",
        "armies"
      ],
      "properties": {
        "characters": {
          "const": "characters.json"
        },
        "regions": {
          "type": "string",
          "enum": [
            "1337",
            "1402",
            "1453"
          ]
        },
        "treasuries": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "armies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "count",
                "region"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50000
                },
                "region": {
                  "type": "string",
                  "pattern": "^region_[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        }
      }
    },
    "victory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crowns",
        "prestige",
        "years_held"
      ],
      "properties": {
        "crowns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "prestige": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "years_held": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "control_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "events_script": {
      "type": "string",
      "pattern": "^events_(1337|1402|1453)\\.json$"
    }
  }
}
