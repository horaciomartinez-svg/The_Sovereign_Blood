{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "characters.json — The Sovereign's Blood (Escenario 1, 1337)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario": {
      "const": "scenario_1337"
    },
    "characters": {
      "type": "array",
      "minItems": 60,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "house",
          "faction",
          "born",
          "died",
          "role",
          "stats",
          "traits",
          "family",
          "claims",
          "source",
          "estimate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "house": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "faction": {
            "type": "string",
            "enum": [
              "england",
              "france",
              "hre",
              "bohemia",
              "hungary",
              "castile",
              "aragon",
              "poland",
              "scotland",
              "papacy",
              "granada",
              "mamluks",
              "golden_horde",
              "byzantium"
            ]
          },
          "born": {
            "type": "integer",
            "minimum": 1200,
            "maximum": 1345
          },
          "died": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1200,
                "maximum": 1337
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "ruler",
              "heir",
              "spouse",
              "general",
              "relative",
              "advisor",
              "regent",
              "claimant"
            ]
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "intrigue",
              "charisma",
              "loyalty",
              "education"
            ],
            "properties": {
              "command": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "intrigue": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "charisma": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "loyalty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "education": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "traits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "family": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "father",
              "mother",
              "spouse",
              "children"
            ],
            "properties": {
              "father": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mother": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "spouse": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "children": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          },
          "claims": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "strength"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "enum": [
                    "england",
                    "france",
                    "hre",
                    "bohemia",
                    "hungary",
                    "castile",
                    "aragon",
                    "poland",
                    "scotland",
                    "papacy",
                    "granada",
                    "mamluks",
                    "golden_horde",
                    "byzantium"
                  ]
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "source": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "estimate": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
