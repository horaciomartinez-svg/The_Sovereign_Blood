{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "units.schema.json",
  "title": "units.json — The Sovereign's Blood (GDD §6.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "era",
          "type",
          "strength",
          "move",
          "cost",
          "multipliers",
          "requires",
          "faction_tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "era": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "infantry",
              "ranged",
              "cavalry",
              "light_cavalry",
              "artillery",
              "special"
            ]
          },
          "strength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "move": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "recruits"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 500
              },
              "recruits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "multipliers": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "faction_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "england",
                "france",
                "hre",
                "bohemia",
                "hungary",
                "castile",
                "aragon",
                "poland",
                "scotland",
                "papacy",
                "granada",
                "mamluks",
                "golden_horde",
                "byzantium"
              ]
            }
          },
          "available_from": {
            "type": "integer",
            "minimum": 1200,
            "maximum": 1500
          },
          "sprite_sheet": {
            "type": "object",
            "description": "Hoja de sprites opcional (GDD §10.3 v2 / D-044/D-047): 3 frames de marcha; size [64,64] infantería/ranged, [64,80] caballería, [64,43] bombarda y hussite_war_wagon.",
            "additionalProperties": false,
            "required": [
              "frames",
              "anim",
              "size",
              "anchor",
              "facing"
            ],
            "properties": {
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "pattern": "^res://assets/art/sprites/units/[a-z0-9_]+_march_[0-9]+\\.png$"
                }
              },
              "anim": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "march",
                  "fps",
                  "loop"
                ],
                "properties": {
                  "march": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    }
                  },
                  "fps": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "loop": {
                    "type": "boolean"
                  }
                }
              },
              "size": {
                "type": "array",
                "description": "Tamaño real de producción: [64,64] infantería/ranged, [64,80] caballería, [64,43] artillería/carro (D-047).",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 128
                }
              },
              "anchor": {
                "type": "string",
                "enum": [
                  "bottom_center"
                ]
              },
              "facing": {
                "type": "string",
                "enum": [
                  "E"
                ]
              }
            }
          }
        }
      }
    }
  }
}
