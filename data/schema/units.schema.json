{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "units.schema.json",
  "title": "units.json — The Sovereign's Blood (GDD §6.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "era",
          "type",
          "strength",
          "move",
          "cost",
          "multipliers",
          "requires",
          "faction_tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "era": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "infantry",
              "ranged",
              "cavalry",
              "light_cavalry",
              "artillery",
              "special"
            ]
          },
          "strength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "move": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "recruits"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 500
              },
              "recruits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "multipliers": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "faction_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "england",
                "france",
                "hre",
                "bohemia",
                "hungary",
                "castile",
                "aragon",
                "poland",
                "scotland",
                "papacy",
                "granada",
                "mamluks",
                "golden_horde",
                "byzantium"
              ]
            }
          },
          "available_from": {
            "type": "integer",
            "minimum": 1200,
            "maximum": 1500
          }
        }
      }
    }
  }
}
